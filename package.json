{
  "name": "jcc-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --check './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "format:fix": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
    "storyblok:login": "storyblok login",
    "storyblok:generate-types": "storyblok ts generate --space 287435740670216 --type-prefix sb",
    "storyblok:pull": "storyblok components pull --space 287435740670216",
    "storyblok:regenerate": "npm run storyblok:pull && npm run storyblok:generate-types"
  },
  "dependencies": {
