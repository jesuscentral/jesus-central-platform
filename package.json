    "next": "^16.0.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-slick": "^0.31.0",
    "slick-carousel": "^1.8.1",
    "storyblok": "^4.0.0-beta.5",
    "storyblok-rich-text-react-renderer": "^3.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
