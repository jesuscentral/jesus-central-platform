    "@storyblok/react": "^5.4.20",
    "@vercel/edge-config": "^1.4.0",
    "@vercel/otel": "^2.1.0",
    "algoliasearch": "^5.42.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^5.2.5",
    "framer-motion": "^12.23.16",
    "lucide-react": "^0.544.0",
