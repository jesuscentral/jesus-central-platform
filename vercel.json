{
  "headers": [
    {
      "source": "/videoclip-short.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)\\.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "src/app/page.tsx": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/videoclip-short.mp4",
      "destination": "/videoclip-short.mp4"
    }
  ]
}
